<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ day.label }} 開いている医院</title>
<!-- scripts/today.py が生成。外部フォント・CDN は使わない（オフラインで印刷可）。 -->
<style>
  @page { size: A4 portrait; margin: 10mm; }
  a { color: inherit; text-decoration: none; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "YuGothic",
                 "Meiryo", "Noto Sans CJK JP", "Noto Sans JP", sans-serif;
    font-size: 9pt; line-height: 1.35; color: #000; background: #fff;
    max-width: 190mm; margin: 0 auto; padding: 4mm 0;
  }
  header { border-bottom: 0.8mm solid #000; padding-bottom: 1.5mm; margin-bottom: 2mm;
           display: flex; justify-content: space-between; align-items: flex-end; gap: 4mm; }
  h1 { font-size: 16pt; }
  .kind { font-size: 12pt; font-weight: 800; border: 0.5mm solid #000; padding: 0.5mm 2.5mm; white-space: nowrap; }
  .alert { border: 0.5mm solid #000; padding: 1.5mm 2mm; margin-bottom: 2mm; font-weight: 700; }
  .meta { font-size: 7.5pt; margin-bottom: 2mm; }
  h2 { font-size: 10.5pt; margin: 3mm 0 1mm; }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 0.25mm solid #000; padding: 1mm 1.5mm; vertical-align: top; text-align: left; }
  th { font-size: 8pt; background: #e6e6e6; }
  tr { break-inside: avoid; }
  .name { font-weight: 700; font-size: 10pt; }
  .sub { font-size: 7.5pt; }
  .hours { white-space: nowrap; font-weight: 700; }
  .tel { font-size: 14pt; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dist { white-space: nowrap; font-size: 8pt; }
  th { white-space: nowrap; }
  /* 区分ごとの色（淡い色・同系色の濃淡で縞々）。色がなくても見出しで区別できる */
  .sec { margin-top: 3mm; break-inside: auto; }
  table.fixed { table-layout: fixed; }
  table.fixed .hours { white-space: normal; }
  .sec h2 { margin: 0; padding: 1mm 2mm; background: var(--hd); border: 0.25mm solid #000; border-bottom: none; }
  .sec h2 .count { font-size: 8pt; font-weight: 400; margin-left: 2mm; }
  .sec h2 { break-after: avoid; }
  .sec th { background: var(--hd); }
  .sec tbody tr:nth-child(odd)  { background: var(--lt); }
  .sec tbody tr:nth-child(even) { background: var(--dk); }
  .sec .none, .sec .unk { border: 0.25mm solid #000; border-top: none; padding: 1mm 2mm; font-size: 7.5pt; background: var(--lt); }
  .sec table + .unk, .sec .none + .unk { border-top: none; }
  .sec .unk span { display: inline-block; margin-right: 4mm; white-space: nowrap; }
  .sec .unk a { font-weight: 700; }
  .sec-0 { --hd: #f2d3b8; --dk: #fbe6d6; --lt: #fff5ed; }  /* 小児科: 杏 */
  .sec-1 { --hd: #c6d8ec; --dk: #e0ebf6; --lt: #f3f8fc; }  /* 大人用: 青 */
  .sec-2 { --hd: #c5dfc3; --dk: #e1efdf; --lt: #f4faf3; }  /* 外科・整形外科: 緑 */
  .sec-3 { --hd: #d9cdea; --dk: #ebe4f4; --lt: #f8f5fb; }  /* 皮膚科: 藤 */
  .sec-4 { --hd: #e6dcae; --dk: #f2ecd0; --lt: #fbf9ee; }  /* 耳鼻咽喉科: 砂 */
  .sec-5 { --hd: #bfdcd8; --dk: #ddeeeb; --lt: #f2f9f8; }  /* 薬局: 青磁 */
  footer { margin-top: 3mm; border-top: 0.3mm solid #000; padding-top: 1mm; font-size: 7.5pt; }
  .phones { display: flex; gap: 6mm; margin-top: 1mm; }
  .phones b { font-size: 14pt; }
  /* スマホ画面（GitHub Pages で見る時）は表を縦積みにする。印刷レイアウトには影響しない */
  @media screen and (max-width: 640px) {
    body { padding: 3mm; font-size: 10pt; }
    header { flex-wrap: wrap; }
    h1 { font-size: 14pt; }
    thead { display: none; }
    table, tbody, tr, td { display: block; width: 100%; }
    tr { border: 0.3mm solid #000; margin-bottom: 2mm; }
    td { border: none; padding: 0.5mm 2mm; }
    .sec tbody tr { border: 0.3mm solid #000; border-top: none; margin-bottom: 0; }
  }
</style>
</head>
<body>
<header>
  <h1>{{ day.label }} 開いている医院</h1>
  <span class="kind">{{ day.kind }}{% if day.renkyu %} ・ 連休中{% endif %}</span>
</header>

{% if day.renkyu %}
<p class="alert">⚠ 連休中（{{ day.renkyu[0].month }}/{{ day.renkyu[0].day }}〜{{ day.renkyu[1].month }}/{{ day.renkyu[1].day }}）。「連休は休診」の医院は一覧から除外しています{% if renkyu_closed %}（{{ renkyu_closed | map(attribute="name") | join("、") }}）{% endif %}。</p>
{% endif %}
{% if special_closed %}
<p class="alert">本日は休診日: {% for c, label in special_closed %}{{ c.name }}（{{ label }}）{{ "、" if not loop.last }}{% endfor %}</p>
{% endif %}
{% if day.nenmatsu %}
<p class="alert">⚠ 年末年始は通常と違う診療時間の医院が多い。必ず電話で確認を。</p>
{% endif %}
<p class="meta"><b>時間は受付できる時間（最終受付まで）。</b>距離は{{ origin.name }}（{{ origin.address | replace("東京都中央区", "") }}）からの徒歩の目安。「要確認」は1年以上情報を確認していない医院。受診前に必ず電話で確認すること。</p>

{% for sec in sections %}
<section class="sec sec-{{ loop.index0 }}">
  <h2>■{{ sec.name }} <span class="count">開いている {{ sec.open | length }}件{% if sec.unknown %}・不明 {{ sec.unknown | length }}件{% endif %}</span></h2>
  {% if sec.open %}
  <table class="fixed">
    <colgroup><col style="width:53%"><col style="width:16%"><col style="width:21%"><col style="width:10%"></colgroup>
    <thead><tr><th>医院</th><th>本日の受付</th><th>電話</th><th>距離</th></tr></thead>
    <tbody>
    {% for c, hours in sec.open %}
    <tr>
      <td><div class="name">{{ c.name }}{% if c.stale %} <span class="sub">（要確認 {{ c.verified_text }}）</span>{% endif %}</div>
          <div class="sub">{{ c.depts | join("・") }}{% if c.address %} ／ {{ c.address | replace("東京都", "") }}{% endif %}</div>
          {% if c.holiday_note or c.note %}<div class="sub">{{ [c.holiday_note, c.note] | select | join(" ／ ") }}</div>{% endif %}</td>
      <td class="hours">{{ hours | safe }}</td>
      <td class="tel">{% if c.tel %}<a href="{{ c.tel_href }}">{{ c.tel }}</a>{% else %}—{% endif %}</td>
      <td class="dist">{% if c.walk_m %}徒歩{{ c.walk_min }}分<br>{{ "{:,}".format(c.walk_m) }}m{{ "*" if c.walk_m_source == "estimated" }}{% else %}—{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="none">今日開いている医院はありません。</p>
  {% endif %}
  {% if sec.unknown %}
  <p class="unk"><b>今日の診療が不明（電話で確認）:</b>
    {% for c in sec.unknown %}<span>{{ c.name }} {% if c.tel %}<a href="{{ c.tel_href }}">{{ c.tel }}</a>{% else %}—{% endif %}</span>{% endfor %}</p>
  {% endif %}
</section>
{% endfor %}

<footer>
  <div class="phones"><span><b>#8000</b> 子ども医療電話相談</span><span><b>#7119</b> 救急相談センター</span><span><b>119</b> 救急車</span></div>
  登録 {{ total }}件中。data/clinics.yaml から自動生成。
</footer>
</body>
</html>
