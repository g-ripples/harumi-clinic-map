<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ card.title }} — 印刷用カード</title>
<!-- scripts/build.py が生成。外部フォント・CDN は使わない（オフラインで印刷可）。 -->
<style>
  @page { size: A4 portrait; margin: 8mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", "YuGothic",
                 "Meiryo", "Noto Sans CJK JP", "Noto Sans JP", sans-serif;
    font-size: 8pt; line-height: 1.3; color: #000; background: #888;
  }
  .howto { max-width: 194mm; margin: 6mm auto 0; color: #fff; font-size: 10pt; }

  /* A4 − 余白8mm×2 = 194mm × 281mm を 2×2 に分割（1面 97mm × 140.5mm） */
  .sheet {
    position: relative; width: 194mm; height: 281mm; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
    background: #fff; margin: 6mm auto; border: 0.3mm dashed #000;
  }
  .sheet + .sheet { break-before: page; }
  /* 裁断線 */
  .sheet::before, .sheet::after { content: ""; position: absolute; z-index: 1; }
  .sheet::before { left: 50%; top: 0; bottom: 0; border-left: 0.3mm dashed #000; }
  .sheet::after  { top: 50%; left: 0; right: 0; border-top: 0.3mm dashed #000; }
  .scissors { position: absolute; z-index: 2; font-size: 9pt; background: #fff; line-height: 1; }
  .scissors.v { left: calc(50% - 1.6mm); top: -0.5mm; }
  .scissors.h { top: calc(50% - 1.8mm); left: -0.5mm; }

  .card { position: relative; padding: 4mm 4.5mm; overflow: hidden; display: flex; flex-direction: column; }

  /* ── 表面 ── */
  .head { display: flex; justify-content: space-between; align-items: baseline;
          border-bottom: 0.6mm solid #000; padding-bottom: 1mm; margin-bottom: 1.5mm; }
  .head h1 { font-size: 11pt; }
  .head .sub { font-size: 7pt; }
  .route { border: 0.3mm solid #000; margin-bottom: 1.5mm; }
  .route h2 { font-size: 8.5pt; padding: 0.6mm 1.5mm; border-bottom: 0.3mm solid #000; background: #e6e6e6; }
  .route h2 .no { display: inline-block; width: 4.2mm; height: 4.2mm; line-height: 4.2mm; text-align: center;
                  border-radius: 50%; background: #000; color: #fff; font-size: 7pt; margin-right: 1mm; }
  .item { display: flex; justify-content: space-between; gap: 2mm; padding: 1mm 1.5mm; }
  .item + .item { border-top: 0.2mm dotted #000; }
  .item .name { font-weight: 700; font-size: 8.5pt; }
  .item .hours { font-size: 7.2pt; }
  .item .right { text-align: right; white-space: nowrap; }
  .tel { font-size: 15pt; font-weight: 800; letter-spacing: 0.02em; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .walk { font-size: 7pt; }
  .route .note { font-size: 7pt; padding: 0 1.5mm 1mm; font-weight: 700; }
  .phones { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; padding: 1mm 0.5mm; }
  .phones .label { font-size: 6.5pt; }
  .home { margin-top: auto; border: 0.5mm solid #000; padding: 1mm 1.5mm; }
  .home .t { font-size: 7pt; font-weight: 700; }
  .line { display: flex; align-items: flex-end; gap: 1mm; height: 6.2mm; font-size: 7.5pt; white-space: nowrap; }
  .line .u { flex: 1; border-bottom: 0.25mm solid #000; height: 100%; }

  /* ── 裏面 ── */
  .back h1 { font-size: 10.5pt; border-bottom: 0.6mm solid #000; padding-bottom: 1mm; margin-bottom: 1mm; margin-right: 20mm; }
  .back .origin { font-size: 6.8pt; margin-bottom: 1mm; padding-right: 20mm; }
  .back .line { height: 8.2mm; font-size: 8pt; }
  .back .line b { min-width: 17mm; }
  .back .small { font-size: 6.8pt; }
  .qr { position: absolute; top: 3.5mm; right: 4mm; width: 17mm; text-align: center; font-size: 5.5pt; }
  .qr img { width: 17mm; height: 17mm; display: block; }
  .back .foot { margin-top: auto; font-size: 6.5pt; border-top: 0.3mm solid #000; padding-top: 1mm; }

  @media print {
    body { background: #fff; }
    .howto { display: none; }
    .sheet { margin: 0; }
  }
</style>
</head>
<body>
<p class="howto">印刷: A4 縦・倍率 100%（「用紙に合わせる」は切）・両面印刷は長辺とじ。1ページ目が表、2ページ目が裏。点線で4つに切り分ける。</p>

{% macro front() %}
<section class="card">
  <div class="head">
    <h1>{{ card.title }}</h1>
    <span class="sub">時間＝最終受付まで ・ 受診前に電話</span>
  </div>
  {% for r in routes %}
  <div class="route">
    <h2><span class="no">{{ loop.index }}</span>{{ r.title }}</h2>
    {% for it in r["items"] %}
    <div class="item">
      <div>
        <div class="name">{{ it.c.name }}</div>
        <div class="hours">{% for label, text in it.hours %}{{ label }} {{ text }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
      </div>
      <div class="right">
        <div class="tel">{{ it.c.tel }}</div>
        {% if it.c.walk_m %}<div class="walk">徒歩{{ it.c.walk_min }}分 / {{ "{:,}".format(it.c.walk_m) }}m{{ "*" if it.c.walk_m_source == "estimated" }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% if r.note %}<div class="note">{{ r.note }}</div>{% endif %}
    {% if r.phones %}
    <div class="phones">
      {% for p in r.phones %}<div><div class="tel">{{ p.tel }}</div><div class="label">{{ p.label }}</div></div>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
  <div class="home">
    <div class="t">119番で伝える（手書き）</div>
    <div class="line">自宅住所<span class="u"></span></div>
    <div class="line">最寄り駅<span class="u"></span>目印<span class="u"></span></div>
  </div>
</section>
{% endmacro %}

{% macro back() %}
<section class="card back">
  <div class="qr"><img src="{{ qr }}" alt="最新版のQRコード">最新版</div>
  <h1>緊急時メモ（手書き）</h1>
  <p class="origin">表面の徒歩分・距離の基準点：<span style="white-space:nowrap">{{ origin.name }}（{{ origin.address | replace("東京都中央区", "") }}）</span>。自宅からの距離ではない。</p>
  <div class="line"><b>氏名</b><span class="u"></span></div>
  <div class="line"><b>生年月日</b><span class="u"></span>年<span class="u"></span>月<span class="u"></span>日</div>
  <div class="line"><b>体重</b><span class="u"></span>kg（<span class="u"></span>年<span class="u"></span>月測定）</div>
  <div class="line"><b>アレルギー</b><span class="u"></span></div>
  <div class="line"><span class="u"></span></div>
  <div class="line"><b>既往・常用薬</b><span class="u"></span></div>
  <div class="line"><span class="u"></span></div>
  <div class="line"><b>保険証</b><span class="small">記号</span><span class="u"></span><span class="small">番号</span><span class="u"></span></div>
  <div class="line"><b>医療証番号</b><span class="u"></span></div>
  <div class="line"><b>保護者①</b><span class="u"></span><span class="small">携帯</span><span class="u"></span></div>
  <div class="line"><b>保護者②</b><span class="u"></span><span class="small">携帯</span><span class="u"></span></div>
  <div class="line"><b>かかりつけ</b><span class="u"></span></div>
  <div class="foot">生成 {{ today }}。診療時間は変わることがある。QR の README で最新情報と確認日を見る。</div>
</section>
{% endmacro %}

<div class="sheet">
  <span class="scissors v">✂</span><span class="scissors h">✂</span>
  {% for _ in range(4) %}{{ front() }}{% endfor %}
</div>
<div class="sheet">
  <span class="scissors v">✂</span><span class="scissors h">✂</span>
  {% for _ in range(4) %}{{ back() }}{% endfor %}
</div>
</body>
</html>
